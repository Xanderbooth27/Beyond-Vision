# Logo.dev publishable key (safe for browser). Used by `img.logo.dev` URLs in the brand ticker.
# Get a key at https://www.logo.dev; do not commit real values. Copy this file to `.env.local`.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# Firebase client configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: override hardcoded admin bypass defaults.
# ADMIN_SESSION_SECRET should be a long random string in production so session cookies cannot be forged.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cloudflare R2 storage. Public base URL serves uploaded media; campaign videos use campaigns/{id}.mp4.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=beyondvision
NEXT_PUBLIC_R2_PUBLIC_URL=
